<Project>
  <PropertyGroup>
    <FFmpegAutoRestore Condition="'$(FFmpegAutoRestore)' == ''">true</FFmpegAutoRestore>
    <FFmpegAllowDownload Condition="'$(FFmpegAllowDownload)' == ''">true</FFmpegAllowDownload>
    <FFmpegRuntimeDirectory Condition="'$(FFmpegRuntimeDirectory)' == ''">$(MSBuildThisFileDirectory)..\.cache\ffmpeg\n9.0.2-39-g7adfbe40dc-20261031\x64</FFmpegRuntimeDirectory>
  </PropertyGroup>
  <!-- Add generated files before assigning output/publish paths, including on a first build. -->
  <Target Name="PrepareFFmpegRuntime" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Condition="'$(FFmpegAutoRestore)' == 'true'"
          Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Restore-FFmpeg.ps1&quot; -Destination &quot;$(FFmpegRuntimeDirectory)&quot; -ArchivePath &quot;$(FFmpegRuntimeArchive)&quot; -AllowDownload &quot;$(FFmpegAllowDownload)&quot;" />
    <ItemGroup>
      <_RequiredFFmpegLibrary Include="avcodec-63.dll;avdevice-63.dll;avfilter-12.dll;avformat-63.dll;avutil-61.dll;swresample-7.dll;swscale-10.dll" />
    </ItemGroup>
    <Error Condition="!Exists('$(FFmpegRuntimeDirectory)\%(_RequiredFFmpegLibrary.Identity)')"
           Text="Missing FFmpeg library: $(FFmpegRuntimeDirectory)\%(_RequiredFFmpegLibrary.Identity). See docs/ffmpeg-runtime.md." />
    <ItemGroup>
      <None Include="@(_RequiredFFmpegLibrary->'$(FFmpegRuntimeDirectory)\%(Identity)')"
            Link="FFMpeg\Lib\x64\%(Filename)%(Extension)"
            CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    </ItemGroup>
  </Target>
</Project>
