<Window x:Class="OPNX.Samples.RtspMultiLiveViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:opnx="clr-namespace:OPNX.UI.WPF.Controls;assembly=OPNX.UI.WPF"
        Title="OPNX RTSP Multi Live Viewer"
        Width="1280"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource Sample.Background}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Background="{StaticResource Sample.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <opnx:OpnxTitlebar Grid.Row="0"
                           Background="{StaticResource Sample.Panel}"
                           ButtonForeground="{StaticResource Sample.Text}"
                           ButtonMouseOverOpacity="0.7"
                           ButtonPressedOpacity="0.45"
                           ButtonSize="32"
                           ButtonImageSize="16"
                           ButtonMargin="6,0,0,0"
                           ControlBoxMargin="18,0,12,0"
                           MinimizeToolTip="Minimize"
                           MaximizeToolTip="Maximize"
                           RestoreToolTip="Restore"
                           CloseToolTip="Close">
            <opnx:OpnxTitlebar.TitleContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10"
                            Height="10"
                            Margin="16,0,10,0"
                            Background="{StaticResource Sample.Accent}" />
                    <TextBlock Text="OPNX RTSP Multi Live Viewer"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Sample"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource Sample.Muted}" />
                </StackPanel>
            </opnx:OpnxTitlebar.TitleContent>
        </opnx:OpnxTitlebar>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Sample.Panel}"
                    BorderBrush="{StaticResource Sample.Border}"
                    BorderThickness="1">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Camera List"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <opnx:OpnxTreeListView x:Name="CameraTree"
                                           Grid.Row="1"
                                           Margin="0,14,0,0"
                                           AutoGenerateColumns="False"
                                           HeadersVisibility="None"
                                           IsReadOnly="True"
                                           RowHeight="34"
                                           BorderThickness="0"
                                           Background="{StaticResource Sample.Panel}"
                                           Foreground="{StaticResource Sample.Text}"
                                           IdPath="Id"
                                           ParentIdPath="ParentId"
                                           IndentWidth="14"
                                           MouseDoubleClick="CameraTree_MouseDoubleClick">
                        <opnx:OpnxTreeListView.Columns>
                            <opnx:OpnxTreeListViewTemplateColumn Width="*">
                                <opnx:OpnxTreeListViewTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding StatusBrush}" />
                                            <StackPanel Grid.Column="2" Orientation="Vertical">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource Sample.Muted}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </opnx:OpnxTreeListViewTemplateColumn.CellTemplate>
                            </opnx:OpnxTreeListViewTemplateColumn>
                        </opnx:OpnxTreeListView.Columns>
                    </opnx:OpnxTreeListView>

                    <opnx:OpnxButton Grid.Row="2" Height="35"
                                     Margin="0,12,0,0" 
                                     Content="Add"
                                     Click="AddCamera_Click" />
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource Sample.Panel}"
                        BorderBrush="{StaticResource Sample.Border}"
                        BorderThickness="1"
                        Padding="12">
                    <StackPanel Orientation="Horizontal">
                        <opnx:OpnxComboBox x:Name="LayoutComboBox"
                                           Width="110"
                                           SelectedIndex="1"
                                           SelectionChanged="LayoutComboBox_SelectionChanged">
                            <ComboBoxItem Content="1x1" Tag="1" />
                            <ComboBoxItem Content="2x2" Tag="2" />
                            <ComboBoxItem Content="3x3" Tag="3" />
                            <ComboBoxItem Content="4x4" Tag="4" />
                        </opnx:OpnxComboBox>

                        <opnx:OpnxNumericBox x:Name="SplitRowsNumericBox"
                                             Margin="8,0,0,0"
                                             Width="58"
                                             Minimum="1"
                                             Maximum="8"
                                             Value="2" />

                        <TextBlock Text="x"
                                   Margin="8,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Sample.Muted}" />

                        <opnx:OpnxNumericBox x:Name="SplitColumnsNumericBox"
                                             Width="58"
                                             Minimum="1"
                                             Maximum="8"
                                             Value="2" />

                        <opnx:OpnxButton Content="Split"
                                         Margin="8,0,0,0"
                                         Width="90"
                                         Click="SplitSelectedCell_Click" />

                        <opnx:OpnxButton Content="Merge"
                                         Margin="8,0,0,0"
                                         Width="90"
                                         Click="MergeSelectedCell_Click" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Background="Black"
                        BorderBrush="{StaticResource Sample.Border}"
                        BorderThickness="1">
                    <ContentControl x:Name="MultiViewHost" />
                </Border>

                <Border Grid.Row="3"
                        Margin="0,12,0,0"
                        Background="{StaticResource Sample.Panel}"
                        BorderBrush="{StaticResource Sample.Border}"
                        BorderThickness="1"
                        Padding="10">
                    <TextBlock x:Name="StatusTextBlock"
                               Text="Ready"
                               Foreground="{StaticResource Sample.Muted}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

