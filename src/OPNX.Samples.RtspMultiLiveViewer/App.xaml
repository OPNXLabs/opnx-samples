<Application x:Class="OPNX.Samples.RtspMultiLiveViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:opnx="clr-namespace:OPNX.UI.WPF.Controls;assembly=OPNX.UI.WPF"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OPNX.UI.WPF;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Sample.Background" Color="#111318" />
            <SolidColorBrush x:Key="Sample.Panel" Color="#1A1D24" />
            <SolidColorBrush x:Key="Sample.Panel2" Color="#222733" />
            <SolidColorBrush x:Key="Sample.Border" Color="#343A46" />
            <SolidColorBrush x:Key="Sample.Text" Color="#F2F4F8" />
            <SolidColorBrush x:Key="Sample.Muted" Color="#AEB6C2" />
            <SolidColorBrush x:Key="Sample.Accent" Color="#4C8DFF" />
            <SolidColorBrush x:Key="Common.Brush.Transparent" Color="Transparent" />
            <SolidColorBrush x:Key="Common.Brush.Foreground" Color="#F2F4F8" />
            <SolidColorBrush x:Key="Common.Brush.Accent" Color="#4C8DFF" />
            <SolidColorBrush x:Key="Common.Brush.Control.Foreground" Color="#F2F4F8" />
            <SolidColorBrush x:Key="Common.Brush.Control.Placeholder2" Color="#AEB6C2" />
            <SolidColorBrush x:Key="Common.Brush.Panel.HeaderBackground" Color="#222733" />
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource Sample.Text}" />
            </Style>

            <Style x:Key="okButtonStyle"
                   TargetType="{x:Type opnx:OpnxButton}"
                   BasedOn="{StaticResource DefaultOpnxButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource Common.Brush.Accent}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource Common.Brush.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Common.Brush.Foreground}" />
                <Setter Property="MouseOverBackground" Value="{DynamicResource Common.Brush.Accent}" />
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource Common.Brush.Accent}" />
                <Setter Property="MouseOverForeground" Value="{DynamicResource Common.Brush.Foreground}" />
                <Setter Property="MouseOverOpacity" Value="0.7" />
                <Setter Property="PressedBackground" Value="{DynamicResource Common.Brush.Accent}" />
                <Setter Property="PressedBorderBrush" Value="{DynamicResource Common.Brush.Accent}" />
                <Setter Property="PressedForeground" Value="{DynamicResource Common.Brush.Foreground}" />
                <Setter Property="PressedOpacity" Value="1" />
            </Style>

            <Style TargetType="{x:Type opnx:OpnxButton}"
                   BasedOn="{StaticResource okButtonStyle}" />

            <Style TargetType="{x:Type opnx:OpnxTextBox}"
                   BasedOn="{StaticResource DefaultOpnxTextBoxStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Background" Value="{DynamicResource Common.Brush.Panel.HeaderBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource Common.Brush.Control.Foreground}" />
                <Setter Property="PlaceholderForeground" Value="{DynamicResource Common.Brush.Control.Placeholder2}" />
                <Setter Property="FontFamily" Value="NanumBarunGothic" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="10,0,10,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="ClearButtonEnabled" Value="False" />
            </Style>

            <Style TargetType="{x:Type opnx:OpnxPasswordBox}"
                   BasedOn="{StaticResource DefaultOpnxPasswordBoxStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Background" Value="{DynamicResource Common.Brush.Panel.HeaderBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource Common.Brush.Control.Foreground}" />
                <Setter Property="PlaceholderForeground" Value="{DynamicResource Common.Brush.Control.Placeholder2}" />
                <Setter Property="FontFamily" Value="NanumBarunGothic" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="10,0,10,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="ClearButtonEnabled" Value="False" />
            </Style>

            <Style TargetType="{x:Type opnx:OpnxComboBox}"
                   BasedOn="{StaticResource DefaultOpnxComboBoxStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Background" Value="{DynamicResource Common.Brush.Panel.HeaderBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource Common.Brush.Control.Foreground}" />
                <Setter Property="FontFamily" Value="NanumBarunGothic" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="10,0,10,0" />
            </Style>

            <Style TargetType="{x:Type opnx:OpnxNumericBox}"
                   BasedOn="{StaticResource DefaultOpnxNumericBoxStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Background" Value="{DynamicResource Common.Brush.Panel.HeaderBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource Common.Brush.Control.Foreground}" />
                <Setter Property="FontFamily" Value="NanumBarunGothic" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="10,0,10,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
