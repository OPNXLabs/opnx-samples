<Window x:Class="OPNX.Samples.PlaybackTimeline.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:opnx="clr-namespace:OPNX.UI.WPF.Controls;assembly=OPNX.UI.WPF"
 Title="OPNX Playback Timeline Sample" Width="1280" Height="840" MinWidth="1120" MinHeight="720"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="13"
 Background="{DynamicResource Common.Brush.Background}" Foreground="{DynamicResource Common.Brush.Foreground}" Loaded="Window_Loaded">
 <Window.Resources>
  <DataTemplate x:Key="RangeLabelTemplate"><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Common.Brush.Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
  <Style TargetType="{x:Type opnx:OpnxPlaybackTimeline}">
   <Setter Property="Background" Value="{DynamicResource Common.Brush.Panel.Background}"/>
   <Setter Property="Foreground" Value="{DynamicResource Common.Brush.Foreground}"/>
   <Setter Property="LeftTimeForeground" Value="{DynamicResource Common.Brush.Muted}"/>
   <Setter Property="CenterTimeForeground" Value="{DynamicResource Common.Brush.Accent}"/>
   <Setter Property="RightTimeForeground" Value="{DynamicResource Common.Brush.Muted}"/>
   <Setter Property="TimeTickBrush" Value="{DynamicResource Common.Brush.Border}"/>
   <Setter Property="SeparatorBrush" Value="{DynamicResource Common.Brush.Panel.Background}"/>
   <Setter Property="TimelineRowBackground" Value="{DynamicResource Common.Brush.Control.Background}"/>
   <Setter Property="SelectedTimelineRowBackground" Value="{DynamicResource Common.Brush.Control.PressedBackground}"/>
   <Setter Property="TimelineRowHeight" Value="34"/>
   <Setter Property="ShowEntityNameOnTimeline" Value="False"/>
   <Setter Property="RecordingBarHeight" Value="20"/>
  </Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
  <opnx:OpnxTitlebar Background="{DynamicResource Common.Brush.Panel.Background}" ButtonForeground="{DynamicResource Common.Brush.Foreground}" ButtonSize="30" ControlBoxMargin="0,0,16,0">
   <opnx:OpnxTitlebar.TitleContent><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
    <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource Common.Brush.Accent}" Margin="0,0,12,0"/>
    <TextBlock Text="OPNX" FontSize="16" FontWeight="Bold"/><TextBlock Text=" /  PLAYBACK TIMELINE" Foreground="{DynamicResource Common.Brush.Muted}" FontSize="12" VerticalAlignment="Center"/>
   </StackPanel></opnx:OpnxTitlebar.TitleContent>
  </opnx:OpnxTitlebar>
  <Grid Grid.Row="1" Margin="24,20,24,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Explore every moment." FontSize="25" FontWeight="SemiBold"/>
    <TextBlock Text="Recording ranges, motion events and time navigation — with simulated data." Foreground="{DynamicResource Common.Brush.Muted}" Margin="0,6,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <opnx:OpnxComboBox x:Name="ThemeBox" Width="155" Margin="0,0,10,0" SelectionChanged="Theme_Changed" ToolTip="Theme"/>
    <opnx:OpnxComboBox x:Name="AccentBox" Width="100" SelectionChanged="Theme_Changed" ToolTip="Accent color"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2" Margin="24,0,24,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="268"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource Common.Brush.Panel.Background}" BorderBrush="{DynamicResource Common.Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="18">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <opnx:OpnxButton x:Name="PlayPauseButton" Content="Simulate play" Style="{StaticResource PrimaryButton}" Click="PlayPause_Click" Margin="0,0,10,0"/>
       <opnx:OpnxComboBox x:Name="RateBox" Grid.Column="1" Width="88"/>
       <TextBlock x:Name="PositionText" Grid.Column="2" Foreground="{DynamicResource Common.Brush.Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Margin="12,0,0,0"/>
      </Grid>
      <opnx:OpnxPlaybackTimeline x:Name="timeline" Grid.Row="1" MinHeight="240" Foreground="{DynamicResource Common.Brush.Foreground}"/>
     </Grid>
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource Common.Brush.Panel.Background}" BorderBrush="{DynamicResource Common.Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="18,14">
     <StackPanel><TextBlock Text="Selection" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBlock x:Name="SelectionText" Text="Click a channel, recording or event to inspect it." Foreground="{DynamicResource Common.Brush.Muted}" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </Grid>
   <Border Grid.Column="2" Background="{DynamicResource Common.Brush.Panel.Background}" BorderBrush="{DynamicResource Common.Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="18">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="gOptions">
     <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <TextBlock Text="Change the control while the timeline is running." Style="{StaticResource Caption}"/>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
      <TextBlock Text="Row height" VerticalAlignment="Center"/><opnx:OpnxNumericBox Grid.Column="1" Minimum="20" Maximum="60" Value="{Binding ElementName=timeline, Path=TimelineRowHeight, Mode=TwoWay}"/>
     </Grid>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
      <TextBlock Text="Bar height" VerticalAlignment="Center"/><opnx:OpnxNumericBox Grid.Column="1" Minimum="4" Maximum="{Binding ElementName=timeline, Path=TimelineRowHeight}" Value="{Binding ElementName=timeline, Path=RecordingBarHeight, Mode=TwoWay}"/>
     </Grid>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
      <TextBlock Text="Top offset" VerticalAlignment="Center"/><opnx:OpnxNumericBox Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding ElementName=timeline, Path=TimelineTopOffset, Mode=TwoWay}"/>
     </Grid>
     <opnx:OpnxCheckBox Content="Channel panel" IsChecked="{Binding ElementName=timeline, Path=IsLeftPanelVisible, Mode=TwoWay}"/>
     <opnx:OpnxCheckBox Content="Names on timeline" IsChecked="{Binding ElementName=timeline, Path=ShowEntityNameOnTimeline, Mode=TwoWay}" Margin="0,5,0,20"/>
     <TextBlock Text="Recording color" Margin="0,0,0,6"/>
     <opnx:OpnxComboBox x:Name="RecordingColorBox" SelectedIndex="1" SelectionChanged="Appearance_Changed" Margin="0,0,0,12">
      <ComboBoxItem Content="Accent"/><ComboBoxItem Content="Amber"/><ComboBoxItem Content="Green"/><ComboBoxItem Content="Blue"/>
     </opnx:OpnxComboBox>
     <TextBlock Text="Row background" Margin="0,0,0,6"/>
     <opnx:OpnxComboBox x:Name="RowColorBox" SelectedIndex="0" SelectionChanged="Appearance_Changed" Margin="0,0,0,12">
      <ComboBoxItem Content="Theme"/><ComboBoxItem Content="Contrast"/><ComboBoxItem Content="Transparent"/>
     </opnx:OpnxComboBox>
     <TextBlock Text="Selected row" Margin="0,0,0,6"/>
     <opnx:OpnxComboBox x:Name="SelectedColorBox" SelectedIndex="0" SelectionChanged="Appearance_Changed" Margin="0,0,0,16">
      <ComboBoxItem Content="Theme"/><ComboBoxItem Content="Green"/><ComboBoxItem Content="Orange"/>
     </opnx:OpnxComboBox>
     <TextBlock Text="{Binding ElementName=timeline, Path=TimeTickThickness, StringFormat=Tick thickness · {0:0.#}}" Margin="0,0,0,8"/>
     <Slider Minimum="0" Maximum="4" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding ElementName=timeline, Path=TimeTickThickness, Mode=TwoWay}"/>
     <TextBlock Text="Simulation moves the timeline only; no media player or files are connected." Style="{StaticResource Caption}" Margin="0,20,0,0"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="{DynamicResource Common.Brush.Panel.Background}" BorderBrush="{DynamicResource Common.Brush.Border}" BorderThickness="0,1,0,0" Padding="24,0">
   <TextBlock x:Name="RequestText" Text="Preparing simulated data…" Foreground="{DynamicResource Common.Brush.Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
  </Border>
 </Grid>
</Window>
