<Application x:Class="OPNX.Samples.PlaybackTimeline.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OPNX.UI.WPF;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Sample.Background" Color="#111318" />
            <SolidColorBrush x:Key="Sample.Panel" Color="#1A1D24" />
            <SolidColorBrush x:Key="Sample.Panel2" Color="#222733" />
            <SolidColorBrush x:Key="Sample.Border" Color="#343A46" />
            <SolidColorBrush x:Key="Sample.Text" Color="#F2F4F8" />
            <SolidColorBrush x:Key="Sample.Muted" Color="#AEB6C2" />
            <SolidColorBrush x:Key="Sample.Accent" Color="#4C8DFF" />
            <SolidColorBrush x:Key="Common.Brush.Transparent" Color="Transparent" />
            <SolidColorBrush x:Key="Common.Brush.Foreground" Color="#F2F4F8" />
            <SolidColorBrush x:Key="Common.Brush.Accent" Color="#4C8DFF" />
            <SolidColorBrush x:Key="Common.Brush.Control.Foreground" Color="#F2F4F8" />
            <SolidColorBrush x:Key="Common.Brush.Control.Placeholder2" Color="#AEB6C2" />
            <SolidColorBrush x:Key="Common.Brush.Panel.HeaderBackground" Color="#222733" />            
        </ResourceDictionary>
         
    </Application.Resources>
</Application>
