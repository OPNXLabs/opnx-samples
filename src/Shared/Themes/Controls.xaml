 <Style x:Key="ValidatedText" TargetType="{x:Type opnx:OpnxTextBox}" BasedOn="{StaticResource {x:Type opnx:OpnxTextBox}}">
  <Style.Triggers><Trigger Property="Validation.HasError" Value="True">
   <Setter Property="BorderBrush" Value="{DynamicResource Common.Brush.Status.Error}" />
   <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
  </Trigger></Style.Triggers>
 </Style>
 <Style x:Key="RangeChoice" TargetType="RadioButton">
  <Setter Property="Foreground" Value="{DynamicResource Common.Brush.Muted}" />
  <Setter Property="Background" Value="{DynamicResource Common.Brush.Control.Background}" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="3,6" Margin="1">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
   </Border>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers><Trigger Property="IsChecked" Value="True">
   <Setter Property="Background" Value="{DynamicResource Common.Brush.Accent}" />
   <Setter Property="Foreground" Value="{DynamicResource Common.Brush.OnAccent}" />
  </Trigger></Style.Triggers>
 </Style>
