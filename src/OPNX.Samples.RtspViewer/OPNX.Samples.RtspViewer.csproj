<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OPNX.Lib" Version="$(OpnxLibVersion)" />
    <PackageReference Include="OPNX.UI.WPF" Version="$(OpnxUiWpfVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Themes\SampleTheme.cs" Link="SampleTheme.cs" />
    <Page Include="..\Shared\Themes\Controls.xaml" Link="Themes\Controls.xaml" />
  </ItemGroup>
  <ItemGroup>
    <None Update="FFMpeg\Lib\x64\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md;..\..\LICENSE.txt;..\..\LICENSE.ko.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\docs\ffmpeg-runtime.md" Link="docs\ffmpeg-runtime.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="Build\FFmpeg.Runtime.targets" />
</Project>
