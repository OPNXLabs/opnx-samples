<Window x:Class="OPNX.Samples.WebRtcViewer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:opnx="clr-namespace:OPNX.UI.WPF.Controls;assembly=OPNX.UI.WPF"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="OPNX WebRTC Viewer" Width="1280" Height="840" MinWidth="1000" MinHeight="680"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="13"
 Background="{DynamicResource Common.Brush.Background}" Foreground="{DynamicResource Common.Brush.Foreground}"
 Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
 <opnx:OpnxTitlebar Background="{DynamicResource Common.Brush.Panel.Background}" ButtonForeground="{DynamicResource Common.Brush.Foreground}" ButtonSize="30" ControlBoxMargin="0,0,16,0">
  <opnx:OpnxTitlebar.TitleContent>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
    <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource Common.Brush.Accent}" Margin="0,0,12,0"/>
    <TextBlock Text="OPNX" FontSize="16" FontWeight="Bold"/>
    <TextBlock Text=" /  WEBRTC VIEWER" Foreground="{DynamicResource Common.Brush.Muted}" FontSize="12" VerticalAlignment="Center"/>
   </StackPanel>
  </opnx:OpnxTitlebar.TitleContent>
 </opnx:OpnxTitlebar>
 <Grid Grid.Row="1" Margin="24,24,24,20"><StackPanel><TextBlock Text="From camera to browser." FontSize="24" FontWeight="SemiBold"/><TextBlock Text="RTSP input, WebRTC transport, browser-native video playback." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><opnx:OpnxComboBox x:Name="ThemeBox" Width="155" SelectionChanged="Theme_Changed"/><opnx:OpnxComboBox x:Name="AccentBox" Width="100" Margin="10,0,0,0" SelectionChanged="Theme_Changed"/></StackPanel></Grid>
 <Border Grid.Row="2" Style="{StaticResource Card}" Width="Auto" Margin="24,0,24,14" Padding="18"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="RTSP URL" Style="{StaticResource Caption}" Margin="0,0,0,6"/><opnx:OpnxTextBox x:Name="UrlBox" ToolTip="rtsp://camera-address:554/stream"/></StackPanel>
 <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Account (optional)" Style="{StaticResource Caption}" Margin="0,0,0,6"/><opnx:OpnxTextBox x:Name="AccountBox"/></StackPanel>
 <StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock Text="Password" Style="{StaticResource Caption}" Margin="0,0,0,6"/><opnx:OpnxPasswordBox x:Name="PasswordBox"/></StackPanel>
 <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0"><opnx:OpnxButton x:Name="ConnectButton" Content="Connect" Style="{StaticResource PrimaryButton}" Click="Connect_Click"/><opnx:OpnxButton x:Name="StopButton" Content="Stop" Margin="8,0,0,0" IsEnabled="False" Click="Stop_Click"/><opnx:OpnxButton x:Name="BrowserButton" Content="Open browser" Margin="8,0,0,0" IsEnabled="False" Click="Browser_Click"/></StackPanel>
 </Grid></Border>
 <Border Grid.Row="3" Margin="24,0,24,16" Background="Black" BorderBrush="{DynamicResource Common.Brush.Border}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><wv:WebView2 x:Name="Browser" DefaultBackgroundColor="Black"/></Border>
 <Border Grid.Row="4" Background="{DynamicResource Common.Brush.Panel.Background}"><TextBlock x:Name="StatusText" Margin="24,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="Initializing browser…" TextTrimming="CharacterEllipsis"/></Border>
 </Grid>
</Window>
